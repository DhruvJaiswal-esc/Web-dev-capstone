NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/exam_system
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Allowed browser origins (CORS), comma separated. Add your deployed frontend URL here.
CLIENT_ORIGIN=http://localhost:5173
# Extra seconds allowed after the deadline before a submission is treated as expired
SUBMIT_GRACE_SECONDS=5
# Used by `npm run seed`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

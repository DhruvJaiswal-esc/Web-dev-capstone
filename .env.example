# Copy to .env before `docker compose up` (never commit .env)
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string

# Browser origin(s) allowed by CORS (comma separated) and the API URL the browser calls
CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:5000/api

# Admin created on first start
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# true = also create demo faculty, students and group CSE-A; false = admin only
SEED_DEMO=true
